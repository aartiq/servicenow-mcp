# NowAIKit environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# Easier: run `nowaikit setup`, then `nowaikit doctor` to check everything.
# Full list of variables: docs/CONFIGURATION.md
# Short names from older docs also work (SN_INSTANCE_URL, SN_USERNAME, SN_PASSWORD,
# SN_OAUTH_CLIENT_ID, SN_OAUTH_CLIENT_SECRET, SN_PERSONA, HTTP_PORT). The SERVICENOW_* names win if both are set.

# =============================================================================
# REQUIRED: ServiceNow Instance
# =============================================================================

# Your ServiceNow instance URL (no trailing slash)
SERVICENOW_INSTANCE_URL=https://yourcompany.service-now.com

# =============================================================================
# REQUIRED: Authentication (choose one method)
# =============================================================================

# Authentication method: basic | oauth
SERVICENOW_AUTH_METHOD=basic

# --- Basic Auth ---
# Use for development and personal use
SERVICENOW_BASIC_USERNAME=your_username
SERVICENOW_BASIC_PASSWORD=your_password

# --- OAuth 2.0 ---
# Recommended for production. `nowaikit setup` can create the OAuth app for you (JWT token format,
# which ServiceNow's own MCP servers and A2A agents require). To do it by hand:
# ServiceNow > System OAuth > Application Registry. See docs/SERVICENOW_OAUTH_SETUP.md.
#
# SERVICENOW_AUTH_METHOD=oauth
# SERVICENOW_OAUTH_CLIENT_ID=your_client_id
# SERVICENOW_OAUTH_CLIENT_SECRET=your_client_secret
# SERVICENOW_OAUTH_USERNAME=service_account_user
# SERVICENOW_OAUTH_PASSWORD=service_account_password

# =============================================================================
# PERMISSION TIERS (all default to false, so the server is read-only until you opt in)
# Launch flags do the same: --allow-write, --allow-cmdb, --allow-scripting, --allow-atf, --allow-agentic, --allow-all
# =============================================================================

# Tier 1: Enable create/update/delete for ITSM, catalog, users, agile
WRITE_ENABLED=false

# Tier 2: Enable CMDB CI write operations (requires WRITE_ENABLED=true)
CMDB_WRITE_ENABLED=false

# Tier 3: Enable script changes: business rules, script includes, changesets (requires WRITE_ENABLED=true).
# Reading scripts never needs this.
SCRIPTING_ENABLED=false

# Tier AI: Enable Now Assist (Otto) generative AI tools
# Requires a Now Assist licence on your ServiceNow instance
NOW_ASSIST_ENABLED=false

# ATF: Enable Automated Test Framework execution tools
ATF_ENABLED=false

# Fluent: allow the local ServiceNow SDK (now-sdk) commands behind the fluent_* tools
FLUENT_ENABLED=false

# =============================================================================
# TOOL PACKAGING (optional)
# =============================================================================

# Load a role-specific subset of tools instead of all 500+ (or set SN_PERSONA, e.g. itsm, developer, admin)
# Options: full | service_desk | change_coordinator | knowledge_author |
#          catalog_builder | system_administrator | platform_developer |
#          portal_developer | integration_engineer | itom_engineer |
#          agile_manager | ai_developer | devops_engineer | itam_analyst
MCP_TOOL_PACKAGE=full

# lean = small core + search_tools (recommended for clients that cap tool count), core, or unset for all
# MCP_TOOL_DISCOVERY=lean

# Interactive forms (MCP Apps) in Claude, ChatGPT and VS Code. Unset = auto, false = off
# NOWAIKIT_MCP_APPS=false

# =============================================================================
# MULTI-INSTANCE (optional)
# =============================================================================

# Path to instances.json for multi-instance support
# SN_INSTANCES_CONFIG=./instances.json
# Instance to use first when several are configured
# SN_DEFAULT_INSTANCE=dev

# =============================================================================
# HTTP MODE (optional, for `nowaikit serve` or TRANSPORT=http)
# =============================================================================

# TRANSPORT=stdio
# PORT=3000
# HOST=127.0.0.1
# Bearer key(s) required by the HTTP API; comma-separated for several keys
# NOWAIKIT_API_KEY=
# CORS_ORIGIN=*

# =============================================================================
# ADVANCED OPTIONS (optional)
# =============================================================================

# Agile table prefix (default: rm_ for SAFe/Scrum modules)
AGILE_TABLE_PREFIX=rm_

# Retries and timeouts
# MAX_RETRIES=3
# RETRY_DELAY_MS=1000
# REQUEST_TIMEOUT_MS=30000

# Write guardrails (comma-separated)
# NOWAIKIT_TABLE_DENYLIST=sys_user,sys_properties
# NOWAIKIT_FIELD_DENYLIST=incident.caller_id
# NOWAIKIT_WRITE_SCOPE_PREFIX=x_acme_

# Audit log of write calls (JSONL). Default: ~/.config/nowaikit/audit.jsonl
# NOWAIKIT_AUDIT_LOG=/path/to/audit.jsonl
# NOWAIKIT_AUDIT_DISABLED=true

# Local Sync folder for pull_artifact / push_artifact
# NOWAIKIT_SYNC_DIR=./servicenow

# upload_attachment file_path: folders allowed and size cap (MB)
# NOWAIKIT_UPLOAD_DIRS=/Users/me/Documents
# NOWAIKIT_UPLOAD_MAX_MB=50
